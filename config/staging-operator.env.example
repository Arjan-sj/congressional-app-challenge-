# Server-side operator shell ONLY. Never pass this file to Flutter.
SAFEROUTES_ENVIRONMENT=staging
SAFEROUTES_PROJECT_ID=replace_with_staging_project_ref
SUPABASE_URL=https://replace_with_staging_project_ref.supabase.co
SAFEROUTES_DATABASE_URL=postgresql://postgres:ENCODED_PASSWORD@db.replace_with_staging_project_ref.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=replace_with_staging_server_key
SAFEROUTES_TEST_REPORTER_ID=replace_with_existing_staging_auth_user_uuid
SAFEROUTES_TEST_MODERATOR_ID=replace_with_existing_staging_moderator_uuid
SAFEROUTES_SEED_SCHOOL_IDS=canonical_school_A_id,canonical_school_B_id
# Optional trusted certificate file if required by the hosted database:
# SAFEROUTES_DATABASE_CA_FILE=C:/secure/path/supabase-ca.crt
